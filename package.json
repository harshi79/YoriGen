{
  "name": "origen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "preview": "vite preview --host 0.0.0.0",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc --noEmit && vite build --config vite.mobile.config.ts",
    "preview:mobile": "vite preview --config vite.mobile.config.ts",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "test": "vitest run && npm run test:server",
    "test:coverage": "vitest run --coverage",
    "test:server": "node --test tests/server.test.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:android": "playwright test --project=android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "happy-dom": "^20.14.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
